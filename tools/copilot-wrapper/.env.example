# BYOK (Bring Your Own Key) で使う OpenAI 互換API のベースURL。
# 例: https://api.openai.com/v1 , http://localhost:11434/v1 (Ollama) , 自社互換エンドポイント等
COPILOT_BYOK_BASE_URL=

# APIキー。Ollama等キー不要なローカルプロバイダーでは空のままでよい。
COPILOT_BYOK_API_KEY=

# 使用するモデルID。BYOK使用時は必須（--model で上書き可）。
COPILOT_BYOK_MODEL=

# プロバイダー種別: openai | azure | anthropic （省略時 openai。Azure OpenAIのホストを使う場合は azure 必須）
COPILOT_BYOK_PROVIDER_TYPE=

# openai/azureのみ: completions | responses （省略時 completions）
COPILOT_BYOK_WIRE_API=

# providerType=azureのときのAPIバージョン（省略時はGA versionless v1ルート）
COPILOT_BYOK_AZURE_API_VERSION=

# copilot-sdk自体のGitHub認証を使わせたくない場合に false を指定（省略時true = ログイン済みユーザー/gh CLI認証を試行）
# BYOK専用で使うだけなら false 推奨。false の場合 COPILOT_GITHUB_TOKEN も未設定でよい。
COPILOT_USE_LOGGED_IN_USER=false

# 明示的なGitHubトークンでSDKランタイム自体を認証したい場合のみ設定（通常BYOK運用では不要）
COPILOT_GITHUB_TOKEN=
