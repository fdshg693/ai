# aim2 environment variables configuration example
# Copy this file to tools/aim2/.env and set your keys.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini (either GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY)
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Ollama (optional, default: http://127.0.0.1:11434/v1)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
