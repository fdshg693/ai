# cp .env.example .env して値を埋める(このファイル自体はVM上でのみ作成する想定)。
# .env は .gitignore 対象(ルートの *.env パターンに一致)。
#
# tools/infra/ai-logs/ 配下で `just vm-env` を実行すると、VM上の /opt/ai-logs/.env が
# 存在しない場合に限り openssl でランダムな値を生成して作成する。

OTLP_AUTH_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Azure Blob archive (Cool). just archive-env が VM の /opt/ai-logs/.env へ追記する。
# 未設定のままでも archive-exporter は再起動ループせず、エラーを出して次の 01:15 UTC まで待つ。
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ai-logs
