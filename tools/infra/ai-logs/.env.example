# cp .env.example .env して値を埋める(このファイルはローカル開発マシン用)。
# .env は .gitignore 対象(ルートの *.env パターンに一致)。
#
# 値の取得方法(VM構築・デプロイ後):
#   just ip             -> SERVER_IP
#   just show-secrets   -> OTLP_AUTH_TOKEN
#
# 埋めたら、Claude Code用のOTLP環境変数を以下のいずれかでシェルに反映・除去できる
# (実体は scripts/client_env.py、just は薄いラッパ):
#   just env-emit [bash|pwsh]      # 一時追加: 出力をevalしてCURRENTシェルにのみ反映
#   just env-install [bash|pwsh]   # 永続追加: シェルプロファイルに追記(新しいシェルから有効)
#   just env-purge [bash|pwsh]     # パージ: シェルプロファイルから削除 + unset文を出力

SERVER_IP=
OTLP_AUTH_TOKEN=

# Azure Blob archive（ローカルの `just archive-list` / `just archive-pull` 用）。
# `just archive-env` が VM へ追記するのと同じ接続文字列をここに置く。日付は UTC。
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ai-logs
