# cp .env.example .env して値を埋める。.env はルートの .gitignore の *.env パターンに
# 一致し、git管理対象外。issue_agent.environment.load_environment()が各エントリポイント
# （check.py / worker.py / attempt_store.py）のmain()冒頭で自動読み込みする
# （override=False。既にexport済みの環境変数を.envの値で上書きしない）。

# Claude Agent SDKの認証（必須。claude_agent_sdk自身がos.environから読む）
ANTHROPIC_API_KEY=

# 以下はすべて省略可（既定値はissue_agent/config.pyのConfig.from_env()参照）
ISSUE_AGENT_OWNER=
ISSUE_AGENT_REPO=
ISSUE_AGENT_TOOL_LABELS=
ISSUE_AGENT_SUPPORTED_TOOL_LABELS=
ISSUE_AGENT_ALLOWED_LOGINS=
ISSUE_AGENT_MAX_ISSUES_PER_CYCLE=
ISSUE_AGENT_WORKER_TIMEOUT_SECONDS=
ISSUE_AGENT_STATE_DB_PATH=
ISSUE_AGENT_LOG_DIR=
ISSUE_AGENT_MAX_TURNS=
ISSUE_AGENT_WORKTREE_ROOT=
