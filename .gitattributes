# Keep repository text files consistent across operating systems.
* text=auto eol=lf

# Treat binary assets as binary so Git never rewrites their contents.
*.7z binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.tar binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary

.github/workflows/*.lock.yml linguist-generated=true merge=ours