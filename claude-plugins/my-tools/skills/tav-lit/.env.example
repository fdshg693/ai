TAVILY_API_KEY=replace-with-your-tavily-api-key

# Optional. Base dir for the written result .md (relative paths resolve against
# the current working directory at invocation). Defaults to temp/simple_tavily.
# TAVILY_OUTPUT_DIR=temp/simple_tavily

# Optional. Whether to write logs/extract_page-log.json (full request/response,
# overwritten each run). Defaults to true; set to false/0/no/off to disable.
# TAVILY_WRITE_LOG=true
