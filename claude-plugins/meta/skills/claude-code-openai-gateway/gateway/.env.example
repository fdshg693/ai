# .env.example → コピーして .env を作り、値を埋める。
#   Git Bash:    cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
# .env はリポジトリの .gitignore（*.env）で除外される。コミットしない。

# 上流プロバイダのキー。Claude Code プロセスには渡さず、ここ（ゲートウェイ側）だけが持つ。
OPENAI_API_KEY=sk-REPLACE_ME

# ゲートウェイの管理キー。その場でランダム生成し、使い回さない。
#   Git Bash:    echo "sk-$(openssl rand -hex 32)"
#   PowerShell:  "sk-" + (-join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) }))
LITELLM_MASTER_KEY=sk-REPLACE_ME

# 任意: 公開ポート（既定 4000）。既に使っていたら変える。
# LITELLM_PORT=4000

# 任意: イメージの固定。再現性が要るならリリースタグ＋digest を入れる。
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:v1.00.0-stable@sha256:...
