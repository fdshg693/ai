# Copy this file to skills-site/.env (untracked, already ignored via the repo-root
# .gitignore's `*.env` rule) and fill in real values. mise.toml in this directory
# loads it automatically for anyone cd'ed into skills-site with mise activated.
# See infra/AGENTS.md for how these are used by `just azure-*`.

AZURE_LOCATION=japaneast
AZURE_RESOURCE_GROUP=rg-ai-skill-catalog
AZURE_STATIC_SITE_NAME=ai-skill-catalog
GITHUB_REPOSITORY=fdshg693/AI

# Server-side OpenRouter key for `/api/suggest` and for `catalog:build` skill
# embeddings (`openai/text-embedding-3-small`). Never expose this to the client.
# For local catalog builds / Functions (`func start` in api/, or via the SWA CLI),
# api/src/lib/load-local-env.js and scripts/build-skill-embeddings.mjs read this
# file automatically as a fallback when OPENROUTER_API_KEY isn't already set —
# no need to also copy it into api/local.settings.json. For production runtime:
# set Application setting `OPENROUTER_API_KEY` on the Static Web App (Azure Portal
# → Configuration). For CI builds: set the same-named GitHub Actions secret
# (`.github/workflows/skill-site.yml` injects it into `catalog:build`).
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
